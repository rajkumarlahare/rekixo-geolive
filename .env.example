# Rekixo GeoLive local development only.
# Never commit real keys.

PORT=8787
NODE_ENV=development

# memory for local demo, postgres for durable/admin/operations mode.
GEOLIVE_PERSISTENCE=memory

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geolive
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

GEOLIVE_ADMIN_SESSION_HOURS=12
GEOLIVE_ADMIN_MAX_FAILED_LOGINS=5
GEOLIVE_ADMIN_LOCK_MINUTES=15

# One-shot retention worker bounds.
GEOLIVE_RETENTION_BATCH_SIZE=5000
GEOLIVE_RETENTION_MAX_BATCHES=20

# Bootstrap only.
# GEOLIVE_BOOTSTRAP_PASSWORD=
# GEOLIVE_BOOTSTRAP_ACCOUNT_ID=

GEOLIVE_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000

# Development-only plain credentials.
GEOLIVE_DEV_PROJECT_ID=demo-project
GEOLIVE_DEV_INGEST_KEY=rgl_dev_ingest_change_me
GEOLIVE_DEV_ADMIN_KEY=rgl_dev_admin_change_me

# Transitional pre-P1C compatibility only.
# New production credentials belong in the api_keys table.
GEOLIVE_KEYS_JSON=

GEOLIVE_ONLINE_SECONDS=120
GEOLIVE_RECENT_SECONDS=900
GEOLIVE_INACTIVE_SECONDS=86400
