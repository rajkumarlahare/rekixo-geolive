# Rekixo GeoLive local development only.
# Never commit real keys.

PORT=8787
NODE_ENV=development

# memory for local demo, postgres for durable mode.
GEOLIVE_PERSISTENCE=memory

# PostgreSQL/PostGIS (required when GEOLIVE_PERSISTENCE=postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geolive
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Comma-separated browser origins allowed to call the API.
GEOLIVE_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000

# Development-only plain keys. Production should use hashed GEOLIVE_KEYS_JSON.
GEOLIVE_DEV_PROJECT_ID=demo-project
GEOLIVE_DEV_INGEST_KEY=rgl_dev_ingest_change_me
GEOLIVE_DEV_ADMIN_KEY=rgl_dev_admin_change_me

# Production format example (hashes only).
# projectId must be the UUID of an existing projects row when Postgres is enabled.
# GEOLIVE_KEYS_JSON=[{"id":"key_01","projectId":"00000000-0000-0000-0000-000000000000","hash":"<sha256-hex>","scopes":["location:write"],"allowedOrigins":["https://example.com"]}]
GEOLIVE_KEYS_JSON=

GEOLIVE_ONLINE_SECONDS=120
GEOLIVE_RECENT_SECONDS=900
GEOLIVE_INACTIVE_SECONDS=86400
