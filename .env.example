# Rekixo GeoLive local development only.
# Never commit real keys.

PORT=8787
NODE_ENV=development

# memory for local demo, postgres for durable/admin/P1C mode.
GEOLIVE_PERSISTENCE=memory

# PostgreSQL/PostGIS (required when GEOLIVE_PERSISTENCE=postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geolive
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# Admin control-plane session policy.
GEOLIVE_ADMIN_SESSION_HOURS=12
GEOLIVE_ADMIN_MAX_FAILED_LOGINS=5
GEOLIVE_ADMIN_LOCK_MINUTES=15

# Bootstrap only. Prefer setting this temporarily in the shell.
# GEOLIVE_BOOTSTRAP_PASSWORD=
# GEOLIVE_BOOTSTRAP_ACCOUNT_ID=

# Global development/fallback browser origins.
GEOLIVE_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000

# Development-only plain credentials.
GEOLIVE_DEV_PROJECT_ID=demo-project
GEOLIVE_DEV_INGEST_KEY=rgl_dev_ingest_change_me
GEOLIVE_DEV_ADMIN_KEY=rgl_dev_admin_change_me

# Transitional pre-P1C compatibility bridge.
# New production credentials should be generated in the GeoLive dashboard
# and stored only in the api_keys table as hashes.
# GEOLIVE_KEYS_JSON=[{"id":"legacy_01","projectId":"00000000-0000-0000-0000-000000000000","hash":"<sha256-hex>","scopes":["location:write"],"allowedOrigins":["https://example.com"]}]
GEOLIVE_KEYS_JSON=

GEOLIVE_ONLINE_SECONDS=120
GEOLIVE_RECENT_SECONDS=900
GEOLIVE_INACTIVE_SECONDS=86400
