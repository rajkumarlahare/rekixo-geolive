# Rekixo GeoLive local development only.
# Never commit real keys.

PORT=8787
NODE_ENV=development

# memory for local demo, postgres for durable/admin/operations mode.
GEOLIVE_PERSISTENCE=memory

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geolive
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

GEOLIVE_ADMIN_SESSION_HOURS=12
GEOLIVE_ADMIN_MAX_FAILED_LOGINS=5
GEOLIVE_ADMIN_LOCK_MINUTES=15
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
GEOLIVE_TRUST_PROXY=false

# Optional restricted browser key for Google Photorealistic 3D Tiles.
# Restrict this key by API and exact production website/referrer.
GEOLIVE_GOOGLE_MAPS_API_KEY=

# One-shot retention worker bounds.
GEOLIVE_RETENTION_BATCH_SIZE=5000
GEOLIVE_RETENTION_MAX_BATCHES=20

# P2 short-lived client ingest tokens.
# Generate at least 32 random bytes and encode them as base64url.
# The first key signs new tokens; all listed keys verify existing tokens.
# Example shape only — never commit a real signing secret.
GEOLIVE_CLIENT_TOKEN_KEYS_JSON=
GEOLIVE_CLIENT_TOKENS_REQUIRED=false

# Development-only fallback signing secret (base64url, >=32 decoded bytes).
# GEOLIVE_DEV_CLIENT_TOKEN_SECRET=

# Optional Android Google Play Integrity configuration.
# Keep the service-account private key only in deployment secrets.
# Example shape:
# GEOLIVE_PLAY_INTEGRITY_APPS_JSON=[{"packageName":"com.example.app","cloudProjectNumber":"1234567890","serviceAccount":{"client_email":"play-integrity@example.iam.gserviceaccount.com","private_key":"<secret-managed-private-key>"},"requiredAppVerdict":"PLAY_RECOGNIZED","requiredDeviceVerdicts":["MEETS_DEVICE_INTEGRITY"],"requireLicensed":false,"maxVerdictAgeSeconds":120}]

# P1E production realtime.
# Leave Redis empty for single-instance deployments.
GEOLIVE_REDIS_URL=
GEOLIVE_REDIS_CHANNEL=rekixo:geolive:events
GEOLIVE_REDIS_REQUIRED=false
GEOLIVE_REALTIME_MAX_REPLAY_EVENTS=1000
GEOLIVE_REALTIME_AUTH_TIMEOUT_MS=5000
GEOLIVE_REALTIME_HEARTBEAT_INTERVAL_MS=25000
GEOLIVE_REALTIME_HEARTBEAT_TIMEOUT_MS=70000

# P4B signed outbound webhooks.
# First key signs newly created/rotated endpoint secrets; keep older
# keys in the array so existing endpoint generations remain derivable.
# Example only — generate >=32 random bytes and store only in secrets.
# GEOLIVE_WEBHOOK_SIGNING_KEYS_JSON=[{"kid":"primary","secret":"<base64url-32-byte-secret>"}]
GEOLIVE_WEBHOOK_SIGNING_KEYS_JSON=
GEOLIVE_WEBHOOK_TIMEOUT_MS=10000
GEOLIVE_WEBHOOK_MAX_ATTEMPTS=8
GEOLIVE_WEBHOOK_BATCH_SIZE=25
GEOLIVE_WEBHOOK_DELIVERY_POLL_MS=5000
GEOLIVE_DWELL_POLL_MS=15000

# Bootstrap only.
# GEOLIVE_BOOTSTRAP_PASSWORD=
# GEOLIVE_BOOTSTRAP_ACCOUNT_ID=

GEOLIVE_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000

# Development-only plain credentials.
GEOLIVE_DEV_PROJECT_ID=demo-project
GEOLIVE_DEV_INGEST_KEY=rgl_dev_ingest_change_me
GEOLIVE_DEV_ADMIN_KEY=rgl_dev_admin_change_me

# Transitional pre-P1C compatibility only.
# New production credentials belong in the api_keys table.
GEOLIVE_KEYS_JSON=

GEOLIVE_ONLINE_SECONDS=120
GEOLIVE_RECENT_SECONDS=900
GEOLIVE_INACTIVE_SECONDS=86400
