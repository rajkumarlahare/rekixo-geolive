{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rekixo-geolive",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/health",
      "/ready",
      "/internal/*",
      "/v1/*",
      "/dashboard/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEOLIVE_ADMIN_SESSION_HOURS": "12",
    "GEOLIVE_ADMIN_MAX_FAILED_LOGINS": "5",
    "GEOLIVE_ADMIN_LOCK_MINUTES": "15",
    "GEOLIVE_ONLINE_SECONDS": "120",
    "GEOLIVE_RECENT_SECONDS": "900",
    "GEOLIVE_INACTIVE_SECONDS": "86400",
    "GEOLIVE_WEBHOOK_TIMEOUT_MS": "10000",
    "GEOLIVE_WEBHOOK_MAX_ATTEMPTS": "8",
    "GEOLIVE_ALLOWED_ORIGINS": "https://rekixo-geolive.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rekixo-geolive-production",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "ProjectRealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectRealtimeRoom"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "rekixo-geolive-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "rekixo-geolive-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "rekixo-geolive-webhooks-dlq",
        "retry_delay": 30
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
